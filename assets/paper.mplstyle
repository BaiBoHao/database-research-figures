figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
font.family: serif
font.serif: Times New Roman, Liberation Serif, DejaVu Serif
font.size: 9
axes.labelsize: 9
axes.titlesize: 10
legend.fontsize: 8
xtick.labelsize: 8
ytick.labelsize: 8
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.linewidth: 0.75
axes.edgecolor: 253448
axes.labelcolor: 253448
xtick.color: 253448
ytick.color: 253448
text.color: 253448
lines.linewidth: 1.65
lines.markersize: 4
legend.frameon: False
legend.handlelength: 2.8
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', '694982', '536276'])
svg.fonttype: none
pdf.fonttype: 42
savefig.dpi: 300
